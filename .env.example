# Runtime
NODE_ENV=development
PORT=3002
NITRO_PRESET=node-server

# Public
NITRO_PUBLIC_DOC_URL=http://localhost:3002

# Notion
NOTION_API_KEY=
NITRO_PRIVATE_NOTION_DB_ID={"document":"<notion-data-source-id>"}

# Auth (empty API key disables the x-api-key check in development)
NITRO_PRIVATE_API_KEY=
NITRO_PRIVATE_JWT_SECRET=
NITRO_PRIVATE_CERTIFICATE_SECRET=

# Document storage (empty bucket falls back to .data/documents in development)
NITRO_PRIVATE_DOCUMENT_BUCKET=
NITRO_PRIVATE_DOCUMENT_ENDPOINT=
NITRO_PRIVATE_DOCUMENT_REGION=auto
NITRO_PRIVATE_DOCUMENT_ACCESS_KEY_ID=
NITRO_PRIVATE_DOCUMENT_SECRET_ACCESS_KEY=

# System
PORT=3002
NODE_ENV=development
NITRO_PRESET=node-server

# Shared (Unprefixed)
# Notion (shared)
NOTION_API_KEY=
NOTION_DB_ID={"document":"<notion-data-source-id>","organization":"<notion-data-source-id>"}

# Scoped Service
# Public base URL of this service. QR codes and `shareUrl` point to <this>/api/document/<id>/view
NITRO_MDOC_PUBLIC_DOC_URL=http://localhost:3002
# Optional. Base URL used by QR codes that verify a document (defaults to the organisation website)
NITRO_MDOC_PUBLIC_VERIFY_URL=
NITRO_MDOC_PRIVATE_API_KEY=
NITRO_MDOC_PRIVATE_JWT_SECRET=
NITRO_MDOC_PRIVATE_CERTIFICATE_SECRET=
# Document storage
NITRO_MDOC_PRIVATE_DOCUMENT_BUCKET=
NITRO_MDOC_PRIVATE_DOCUMENT_ENDPOINT=
NITRO_MDOC_PRIVATE_DOCUMENT_REGION=auto
NITRO_MDOC_PRIVATE_DOCUMENT_ACCESS_KEY_ID=
NITRO_MDOC_PRIVATE_DOCUMENT_SECRET_ACCESS_KEY=

# System
PORT=3002
NODE_ENV=development
NITRO_PRESET=node-server

# Shared (Unprefixed)
# Notion (shared)
NOTION_API_KEY=
NOTION_DB_ID={"document":"<notion-data-source-id>"}

# Scoped Service
NITRO_MDOC_PUBLIC_DOC_URL=http://localhost:3002
NITRO_MDOC_PRIVATE_API_KEY=
NITRO_MDOC_PRIVATE_JWT_SECRET=
NITRO_MDOC_PRIVATE_CERTIFICATE_SECRET=
# Document storage
NITRO_MDOC_PRIVATE_DOCUMENT_BUCKET=
NITRO_MDOC_PRIVATE_DOCUMENT_ENDPOINT=
NITRO_MDOC_PRIVATE_DOCUMENT_REGION=auto
NITRO_MDOC_PRIVATE_DOCUMENT_ACCESS_KEY_ID=
NITRO_MDOC_PRIVATE_DOCUMENT_SECRET_ACCESS_KEY=

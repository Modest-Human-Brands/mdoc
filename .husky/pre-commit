#!/usr/bin/env sh
set -e

# 1. Secret Scanning with Gitleaks (handles filenames with spaces)
if command -v gitleaks >/dev/null 2>&1; then
  git diff --cached --name-only --diff-filter=ACMR -z | while IFS= read -r -d '' file; do
    if [ -f "$file" ]; then
      gitleaks detect --source="$file" --no-git --no-banner --verbose
    fi
  done
else
  echo "⚠️ gitleaks not found; skipping secret scan"
fi

# 2. Extract staged JS/TS/Vue files for ESLint
LINT_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|ts|mjs|cjs|vue)$' || true)

if [ -n "$LINT_FILES" ]; then
  # Pass filtered files safely quoted via xargs
  echo "$LINT_FILES" | tr '\n' '\0' | xargs -0 bun x eslint --fix --no-error-on-unmatched-pattern
fi

# 3. Format all staged files with Prettier (safely handles spaces and ignores non-formattable files)
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r bun x prettier --write --ignore-unknown

# 4. Stage any formatting changes made by Prettier/ESLint
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r git add
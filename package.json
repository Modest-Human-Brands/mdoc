{
  "name": "mdoc",
  "version": "0.3.16",
  "description": "A structured document management service for creating, storing, and collaborating on business documents and deliverables.",
  "author": "Shirsendu Bairagi <shirsendu2001@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Modest-Human-Brands/mdoc.git"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.14.0",
    "pnpm": "^9.15.0 || ^10.2.0 || ^12.0.0",
    "bun": "^1.2.9"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "prepare": "husky || true",
    "dev": "nitro dev",
    "detect": "gitleaks git --verbose",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "test:load": "k6 run tests/load.test.ts",
    "build": "nitro build",
    "generate": "nitro generate",
    "preview": "nitro preview",
    "start": "node --env-file=.env.prod .output/server/index.mjs",
    "clean": "nitro cleanup",
    "docker:build": "docker build --build-arg VERSION=dev --build-arg BUILD_TIME=now -t mdoc:dev .",
    "docker:start": "docker run --detach --name mdoc-dev --env-file .env.prod -p 3500:3000 mdoc:dev",
    "samples": "nitro task run templates:sample-images",
    "samples:check": "nitro task run templates:sample-images --payload {\"check\":true}",
    "fonts:warm": "nitro task run fonts:warm",
    "documents:migrate": "nitro task run documents:migrate"
  },
  "dependencies": {
    "@ceereals/vue-pdf": "^0.3.1",
    "@napi-rs/canvas": "^1.0.11",
    "@notionhq/client": "^5.27.1",
    "@signpdf/placeholder-plain": "^4.0.0",
    "@signpdf/signer-p12": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "@types/mime-types": "^3.0.1",
    "asn1js": "^4.0.0",
    "aws4fetch": "^1.0.20",
    "date-fns": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "magic-regexp": "^0.11.2",
    "marked": "^18.1.1",
    "mime-types": "^3.0.2",
    "mupdf": "^1.28.1",
    "nitro": "^3.0.260903-beta",
    "nitro-mcp-toolkit": "^0.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pkijs": "^3.4.2",
    "sharp": "^0.35.5",
    "unifont": "^1.0.3",
    "unplugin-vue": "^8.0.0",
    "unstorage": "2.0.0-beta.0",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@dotenvx/dotenvx": "^2.38.1",
    "@types/bun": "^1.4.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/marked": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-unjs": "^0.6.2",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "@ceereals/vue-pdf"
  ],
  "overrides": {
    "asn1js": "^4.0.0"
  }
}
